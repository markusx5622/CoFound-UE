rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@(live\\.uem\\.es|universidadeuropea\\.es)$');
    }

    function isValidUserPayload(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('degree' in data) || (data.degree is string && data.degree.size() <= 120))
        && (!('campus' in data) || (data.campus is string && data.campus.size() <= 80))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('skills' in data) || (data.skills is list && data.skills.size() <= 20));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                   && request.auth.uid == userId 
                   && (!('email' in request.resource.data))
                   && isValidUserPayload(request.resource.data);
      allow update: if isAuthenticated() 
                   && request.auth.uid == userId 
                   && isValidUserPayload(request.resource.data)
                   && (
                     !('email' in request.resource.data)
                     || (resource != null && 'email' in resource.data && request.resource.data.email == resource.data.email)
                   );
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.creator_id == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() > 0 && request.resource.data.creatorName.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20 && request.resource.data.description.size() <= 1500
        && request.resource.data.profiles is list
        && request.resource.data.profiles.size() >= 1 && request.resource.data.profiles.size() <= 10;
      allow update: if isAuthenticated() 
        && resource.data.creator_id == request.auth.uid
        && (!('creator_id' in request.resource.data) || request.resource.data.creator_id == resource.data.creator_id)
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() >= 20 && request.resource.data.description.size() <= 1500))
        && (!('profiles' in request.resource.data) || (request.resource.data.profiles is list && request.resource.data.profiles.size() >= 1 && request.resource.data.profiles.size() <= 10));
      allow delete: if isAuthenticated() && resource.data.creator_id == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow get: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      allow list: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.creatorId is string
        && request.resource.data.creatorId.size() > 0
        && request.resource.data.creatorId != request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.status == 'pending';
      allow update: if isAuthenticated()
        && request.resource.data.applicantId == resource.data.applicantId
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.projectId == resource.data.projectId
        && (
          (
            resource.data.creatorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastMessageAt', 'lastMessageSenderId', 'lastReadByCreator'])
            && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.status in ['pending', 'accepted', 'rejected'])
            && (!('lastMessageSenderId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastMessageSenderId == request.auth.uid)
          )
          || (
            resource.data.applicantId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageSenderId', 'lastReadByApplicant'])
            && (!('lastMessageSenderId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastMessageSenderId == request.auth.uid)
          )
        );
      allow delete: if isAuthenticated() && (resource.data.applicantId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          (get(/databases/$(database)/documents/applications/$(applicationId)).data.applicantId == request.auth.uid || 
           get(/databases/$(database)/documents/applications/$(applicationId)).data.creatorId == request.auth.uid);
        allow create: if isAuthenticated() && 
          (get(/databases/$(database)/documents/applications/$(applicationId)).data.applicantId == request.auth.uid || 
           get(/databases/$(database)/documents/applications/$(applicationId)).data.creatorId == request.auth.uid) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 1000;
        allow delete: if isAuthenticated() && 
          (get(/databases/$(database)/documents/applications/$(applicationId)).data.applicantId == request.auth.uid || 
           get(/databases/$(database)/documents/applications/$(applicationId)).data.creatorId == request.auth.uid);
      }
    }
  }
}
